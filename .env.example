# Development environment variables
# Copy this file to .env and customize as needed

# Logging
VITE_LOG=false

# Game public mode
VITE_GAME_PUBLIC=false

# Day cycle progress (0-1)
VITE_DAY_CYCLE_PROGRESS=

# Year cycle progress (0-1)
VITE_YEAR_CYCLE_PROGRESS=

# Music enabled
VITE_MUSIC=true

# Player spawn point
VITE_PLAYER_SPAWN=landing

# Whispers count
VITE_WHISPERS_COUNT=30

# Server URL (optional - for multiplayer features)
VITE_SERVER_URL=